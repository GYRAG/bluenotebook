---
import { getCollection, render } from 'astro:content';
import Shell from '@/layouts/Shell.astro';
import Panel from '@/components/Panel.astro';
import Figure from '@/components/Figure.astro';
import FigureTools from '@/components/FigureTools.astro';
import { formulasView, propertiesView } from '@/components/content';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map(topic => ({ params: { subject: topic.data.subject, slug: topic.id }, props: { topic } }));
}
const { topic } = Astro.props;
const { Content } = await render(topic);
const fig = topic.data.figure;
---
<Shell title={topic.data.title} description={topic.data.summary} current={{ subject: topic.data.subject, slug: topic.id }} draft={topic.data.status === 'draft'} lede={topic.data.summary}>
  {fig ? <Figure name={fig} /> : (
    <div class="figure paper"><p class="empty figure-empty"><b>ნახაზი ჯერ არ არის</b>ინტერაქტიული ფიგურა აქ გამოჩნდება.</p></div>
  )}
  {topic.data.figures.map(name => <Figure name={name} alt />)}
  <Panel slot="panel">
    {fig ? <FigureTools slot="tools" name={fig} /> : <p slot="tools" class="empty"><b>ჯერ ცარიელია</b>სლაიდერები და გადამრთველები გამოჩნდება, როცა თემას ნახაზი ექნება.</p>}
    <div slot="formulas"><Content components={formulasView} /></div>
    <div slot="props"><Content components={propertiesView} /></div>
  </Panel>
</Shell>
<script>import '@/scripts/topic';</script>
