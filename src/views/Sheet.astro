---
import Shell from '@/layouts/Shell.astro';
import Figure from '@/components/Figure.astro';
import { langOf, t } from '@/i18n';
const lang = langOf(Astro.url);
---
<Shell title={t(lang, 'სუფთა ფურცელი')} panel={false} full description={t(lang, 'ცარიელი ბადე ხატვისთვის: ფანქარი, მონაკვეთი, წრეწირი, მართკუთხედი, სამკუთხედი.')} lede={t(lang, 'ხატე ბადეზე; ერთი უჯრა — სიგრძის ერთეული. ფურცელს ცარიელ ადგილზე გადათრევით (ან ორი თითით) გადააადგილებ, მასშტაბს — ბორბლით ან ორი თითით.')}>
  <Figure name="blank" draw />
</Shell>
