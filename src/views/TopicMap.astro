---
import Shell from '@/layouts/Shell.astro';
import { allTopics, sectionsOf, subjectsWithContent, topicUrl } from '@/lib/topics';
import { caps, langOf, t as tr } from '@/i18n';

// The topic map: one topic at a time, with the topics it builds on above it and the ones that build
// on it below, joined by lines; any card re-centres the map on itself. The whole reading path (all
// prerequisites, in reading order) folds out below. Every topic is listed on the side.
const lang = langOf(Astro.url);
const topics = await allTopics(lang);
const chapters = subjectsWithContent(topics).flatMap(sub => sectionsOf(topics, sub, lang));
const ids = new Set(topics.map(tp => tp.id));
const nodes = chapters.flatMap(c => c.items.map(tp => ({
  id: tp.id, title: tp.data.title, url: topicUrl(tp, lang), chapter: `${c.no} · ${caps(c.label)}`, chapterName: c.label, summary: tp.data.summary,
  pre: tp.data.prerequisites.filter(p => ids.has(p)),
})));
const L = {
  start: tr(lang, 'საწყისი თემა — აქედან შეიძლება დაწყება.'), last: tr(lang, 'ამ თემას ჯერ არცერთი თემა არ ეყრდნობა.'),
  path: tr(lang, 'წაკითხვის მთელი გზა'),
};
---
<Shell title={tr(lang, 'თემების რუკა')} panel={false} lede={tr(lang, 'აირჩიე თემა — გამოჩნდება, რას ეყრდნობა ის და რა ეყრდნობა მას.')}>
  <div class="tm" data-l={JSON.stringify(L)}>
    <section class="view" aria-live="polite">
      <svg class="lines" aria-hidden="true"></svg>
      <p class="k up">{tr(lang, 'ეყრდნობა')}</p>
      <div class="cards" data-pre></div>
      <article class="focus" data-focus>
        <p class="ch" data-ch></p>
        <h2 class="ft"><a data-title href="/"></a></h2>
        <p class="fs" data-sum></p>
      </article>
      <p class="k down">{tr(lang, 'მას ეყრდნობა')}</p>
      <div class="cards" data-post></div>
      <details class="path" data-path-box>
        <summary data-path-h></summary>
        <ol data-path></ol>
      </details>
    </section>
    <nav class="all" aria-label={tr(lang, 'ყველა თემა')}>
      <h2 class="k">{tr(lang, 'ყველა თემა')}</h2>
      {chapters.map(c => (
        <section>
          <h3><span class="no">{c.no}</span> <span aria-hidden="true">{caps(c.label)}</span><span class="sr-only">{c.label}</span></h3>
          <ul>{c.items.map(tp => <li><button class="item" type="button" data-id={tp.id} aria-pressed="false">{tp.data.title}</button></li>)}</ul>
        </section>
      ))}
    </nav>
  </div>
</Shell>
<script type="application/json" id="map-data" set:html={JSON.stringify(nodes).replace(/</g, '\\u003c')} />
<script>
  import { load } from '@/lib/store';
  import { plain } from '@/i18n/client';

  interface Node { id: string; title: string; url: string; chapter: string; chapterName: string; summary: string; pre: string[] }
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const nodes = JSON.parse($('#map-data').textContent!) as Node[];
  const L = JSON.parse($('.tm').dataset.l!) as Record<string, string>;
  const byId = new Map(nodes.map(n => [n.id, n])), order = new Map(nodes.map((n, i) => [n.id, i]));
  const post = (id: string) => nodes.filter(n => n.pre.includes(id)).map(n => n.id);
  function before(id: string) { // every prerequisite, all the way down, in reading order (a cycle stops at what was seen)
    const seen = new Set<string>(), todo = [...byId.get(id)!.pre];
    while (todo.length) { const x = todo.pop()!; if (x !== id && !seen.has(x)) { seen.add(x); todo.push(...byId.get(x)!.pre); } }
    return [...seen].sort((a, b) => order.get(a)! - order.get(b)!);
  }

  function card(id: string) {
    const n = byId.get(id)!, b = document.createElement('button');
    b.type = 'button'; b.className = 'card'; b.dataset.id = id;
    b.setAttribute('aria-label', `${n.title}, ${n.chapterName}`); // the chapter's capitals are for the eye
    b.innerHTML = '<span class="cc"></span><span class="ct"></span>';
    b.querySelector('.cc')!.textContent = n.chapter;
    b.querySelector('.ct')!.textContent = n.title;
    return b;
  }
  function fill(box: HTMLElement, ids: string[], none: string) {
    box.replaceChildren(...(ids.length ? ids.map(card) : [Object.assign(document.createElement('p'), { className: 'none', textContent: none })]));
  }

  // lines from each card above into the focus, and from the focus into each card below
  const svg = $<SVGSVGElement>('.lines'), view = $('.view');
  function draw() {
    const v = view.getBoundingClientRect(), f = $('[data-focus]').getBoundingClientRect();
    const at = (r: DOMRect, y: number) => [r.left + r.width / 2 - v.left, y - v.top] as const;
    const curve = ([x1, y1]: readonly [number, number], [x2, y2]: readonly [number, number]) => {
      const m = (y1 + y2) / 2;
      return `<path d="M${x1} ${y1}C${x1} ${m} ${x2} ${m} ${x2} ${y2}"/>`;
    };
    // a row on one line: a line per card; a row that wraps (phones): one line for the whole row
    const ends = (sel: string, edge: 'top' | 'bottom') => {
      const cards = [...document.querySelectorAll<HTMLElement>(`${sel} .card`)].map(c => c.getBoundingClientRect());
      if (!cards.length) return [];
      if (cards.every(r => Math.abs(r.top - cards[0]!.top) < 2)) return cards.map(r => at(r, r[edge]));
      const box = $(sel).getBoundingClientRect();
      return [at(box, box[edge])];
    };
    const up = ends('[data-pre]', 'bottom').map(p => curve(p, at(f, f.top)));
    const down = ends('[data-post]', 'top').map(p => curve(at(f, f.bottom), p));
    svg.setAttribute('viewBox', `0 0 ${v.width} ${v.height}`);
    svg.innerHTML = [...up, ...down].join('');
  }
  new ResizeObserver(draw).observe(view);

  function show(id: string) {
    const n = byId.get(id) ?? nodes[0]!;
    fill($('[data-pre]'), n.pre, L.start!);
    fill($('[data-post]'), post(n.id), L.last!);
    const shown = Object.assign(document.createElement('span'), { textContent: n.chapter }); // capitals for the eye, the name for screen readers
    shown.setAttribute('aria-hidden', 'true');
    $('[data-ch]').replaceChildren(shown, Object.assign(document.createElement('span'), { className: 'sr-only', textContent: n.chapterName }));
    Object.assign($<HTMLAnchorElement>('[data-title]'), { href: n.url, textContent: n.title });
    $('[data-sum]').textContent = n.summary;
    const path = before(n.id);
    $('[data-path-box]').hidden = path.length < 2;
    $('[data-path-h]').textContent = `${L.path} (${path.length})`;
    $('[data-path]').replaceChildren(...path.map(x => {
      const li = document.createElement('li');
      li.append(Object.assign(document.createElement('a'), { href: byId.get(x)!.url, textContent: byId.get(x)!.title }));
      return li;
    }));
    document.querySelectorAll<HTMLButtonElement>('.item').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.id === n.id)));
    history.replaceState(null, '', `#${n.id}`);
    draw();
  }
  function select(id: string) {
    const go = () => show(id);
    const vt = (document as Document & { startViewTransition?: (f: () => void) => unknown }).startViewTransition;
    if (vt && !matchMedia('(prefers-reduced-motion: reduce)').matches) vt.call(document, go); else go();
    if (!matchMedia('(min-width: 900px)').matches) view.scrollIntoView({ block: 'start', behavior: 'smooth' });
  }
  document.querySelector('.tm')!.addEventListener('click', e => {
    const b = (e.target as Element).closest<HTMLElement>('.card, .item');
    if (b) select(b.dataset.id!);
  });

  // first: the topic in the link, else the last one read, else the first
  const last = load<{ url: string } | null>('last', null);
  const lastId = last && nodes.find(n => plain(n.url) === plain(last.url))?.id;
  show(decodeURIComponent(location.hash.slice(1)) || lastId || nodes[0]!.id);
  addEventListener('hashchange', () => show(decodeURIComponent(location.hash.slice(1))));
</script>
<style>
  .tm { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: var(--s5) 48px; align-items: start; margin-top: var(--s4); padding-bottom: var(--s5); color: var(--ink-2); }
  .k { font: var(--w2) var(--fs-ui) var(--font-body); letter-spacing: .02em; }
  .view .k { justify-self: start; margin-bottom: calc(-1 * var(--s3)); } /* row captions, clear of the lines in the middle */

  /* the focus with its neighbours */
  .view { position: relative; display: grid; gap: 28px; justify-items: center; padding: var(--s2) 0 var(--s4); }
  .lines { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .lines :global(path) { fill: none; stroke: var(--line); stroke-width: 1.5; }
  .cards { position: relative; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s3); max-width: 720px; }
  .cards :global(.card) { display: grid; gap: 2px; width: 196px; min-height: 64px; padding: var(--s2) var(--s3); border: var(--bw) solid var(--line-2); border-radius: var(--r); background: var(--paper); text-align: left; }
  .cards :global(.card:hover) { border-color: var(--ink); }
  .cards :global(.card:hover .ct) { text-decoration: underline; text-underline-offset: 4px; }
  .cards :global(.cc) { font-size: 11px; color: var(--ink-2); text-transform: uppercase; letter-spacing: .06em; } /* a chapter in capitals, the topic in plain letters */
  .cards :global(.ct) { font-size: 15px; line-height: 1.35; color: var(--ink); }
  .cards :global(.none) { font-size: 14px; padding: var(--s2) var(--s3); background: var(--paper); }
  .focus { position: relative; width: min(440px, 100%); padding: var(--s3) var(--s4) var(--s4); border: var(--bw) solid var(--ink); border-radius: var(--r); background: var(--paper); text-align: center; }
  .ch { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
  .ft { font: var(--w2) 24px/1.25 var(--font-head); margin: var(--s1) 0 var(--s2); }
  .ft a { color: var(--ink); text-decoration: underline 1.5px; text-underline-offset: 6px; }
  .fs { font-size: 15px; }
  .path { position: relative; width: min(440px, 100%); font-size: 15px; }
  .path summary { display: flex; align-items: center; justify-content: center; min-height: 44px; color: var(--ink-2); text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .path ol { margin: var(--s2) 0 0; padding-left: 1.6em; display: grid; gap: 2px; }
  .path :global(a) { display: inline-flex; min-height: 32px; align-items: center; color: var(--ink); }

  /* every topic, quietly, on the side */
  .all { font-size: 14px; }
  .all .k { text-align: left; margin-bottom: var(--s2); }
  .all h3 { font: var(--w2) 12px var(--font-body); color: var(--ink-2); text-transform: uppercase; letter-spacing: .06em; margin: var(--s3) 0 2px; }
  .all h3 .no { font: var(--w2) 14px var(--font-head); color: var(--ink); margin-right: 6px; }
  .all ul { margin-left: 6px; padding-left: 12px; border-left: 1px solid var(--line-2); }
  .all ul { list-style: none; }
  .item { display: flex; align-items: center; width: 100%; min-height: 34px; text-align: left; color: var(--ink-2); line-height: 1.3; }
  .item:hover { color: var(--ink); }
  .item[aria-pressed='true'] { color: var(--ink); font-weight: var(--w2); text-decoration: underline 1.5px; text-underline-offset: 5px; }
  @media (pointer: coarse) { .item { min-height: 44px; } }
  @media (max-width: 899px) {
    .tm { grid-template-columns: minmax(0, 1fr); }
    .view { scroll-margin-top: var(--s4); }
    .cards :global(.card) { width: calc(50% - var(--s2)); }
    .all { columns: 2; column-gap: var(--s4); }
    .all section { break-inside: avoid; }
  }
</style>
